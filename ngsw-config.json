{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/assets/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "weather-forecast",
      "urls": ["https://api.open-meteo.com/**"],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "3h",
        "timeout": "6s",
        "strategy": "freshness"
      }
    },
    {
      "name": "geocoding",
      "urls": ["https://geocoding-api.open-meteo.com/**", "https://nominatim.openstreetmap.org/**"],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "7d",
        "timeout": "4s",
        "strategy": "performance"
      }
    }
  ]
}
